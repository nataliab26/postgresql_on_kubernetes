apiVersion: v1
kind: Secret
metadata:
  name: {{ replica_watch_name }}-db
  namespace: {{ replica_watch_namespace }}
type: Opaque
data:
  PGHOST: {{ replica_watch_db_host | b64encode }}
  PGPORT: {{ replica_watch_db_port | string | b64encode }}
  PGDATABASE: {{ test_db_name | b64encode }}
  PGUSER: {{ replica_watch_db_user | b64encode }}
  PGPASSWORD: {{ replica_watch_db_password | b64encode }}
  PGSSLMODE: {{ pg_client_sslmode | b64encode }}
