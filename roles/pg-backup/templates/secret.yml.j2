apiVersion: v1
kind: Secret
metadata:
  name: {{ pg_backup_name }}-db
  namespace: {{ pg_backup_namespace }}
type: Opaque
data:
  PGHOST: {{ pg_backup_db_host | b64encode }}
  PGPORT: {{ pg_backup_db_port | string | b64encode }}
  PGDATABASE: {{ test_db_name | b64encode }}
  PGUSER: {{ backup_db_user | b64encode }}
  PGPASSWORD: {{ backup_db_password | b64encode }}
  PGSSLMODE: {{ pg_client_sslmode | b64encode }}
