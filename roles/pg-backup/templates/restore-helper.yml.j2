apiVersion: v1
kind: Pod
metadata:
  name: {{ pg_backup_name }}-helper
  namespace: {{ pg_backup_namespace }}
spec:
  terminationGracePeriodSeconds: 1
  securityContext:
    runAsNonRoot: true
    runAsUser: {{ pg_backup_uid }}
    runAsGroup: {{ pg_backup_uid }}
  containers:
    - name: helper
      image: {{ pg_backup_image }}
      command: ["sleep", "infinity"]
      securityContext:
        allowPrivilegeEscalation: false
      volumeMounts:
        - name: backup
          mountPath: /backup
          readOnly: true
      resources:
        requests:
          cpu: 10m
          memory: 16Mi
        limits:
          memory: 64Mi
  volumes:
    - name: backup
      persistentVolumeClaim:
        claimName: {{ pg_backup_name }}-storage
