apiVersion: v1
kind: Secret
metadata:
  name: {{ app_name }}-db
  namespace: {{ app_namespace }}
type: Opaque
data:
  PGHOST: {{ app_db_host | b64encode }}
  PGPORT: {{ app_db_port | string | b64encode }}
  PGDATABASE: {{ test_db_name | b64encode }}
  PGUSER: {{ test_db_user | b64encode }}
  PGPASSWORD: {{ test_db_password | b64encode }}
  PGSSLMODE: {{ pg_client_sslmode | b64encode }}
