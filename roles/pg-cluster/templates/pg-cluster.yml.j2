apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: {{ cnpg_cluster_name }}
  namespace: {{ cnpg_cluster_namespace }}
spec:
  instances: {{ cnpg_cluster_instances }}
  imageName: {{ cnpg_cluster_image }}
  primaryUpdateStrategy: {{ cnpg_cluster_primary_update_strategy }}
  primaryUpdateMethod: {{ cnpg_cluster_primary_update_method }}
  enableSuperuserAccess: false
  postgresql:
    parameters:
      password_encryption: scram-sha-256
    pg_hba:
      - host all postgres all reject
{% for cidr in cnpg_pod_cidrs %}
      - hostssl {{ test_db_name }} {{ test_db_user }} {{ cidr }} scram-sha-256
{% endfor %}
{% if pg_access_external %}
{% for ip in cnpg_node_ips %}
      - hostssl {{ test_db_name }} {{ test_db_user }} {{ ip }}/32 scram-sha-256
{% endfor %}
{% endif %}
{% for cidr in cnpg_pod_cidrs %}
      - hostssl {{ test_db_name }} {{ replica_watch_db_user }} {{ cidr }} scram-sha-256
{% endfor %}
{% for cidr in cnpg_pod_cidrs %}
      - hostssl {{ test_db_name }} {{ backup_db_user }} {{ cidr }} scram-sha-256
{% endfor %}
      - host all all all reject
  storage:
    size: {{ cnpg_cluster_storage_size }}
    storageClass: {{ cnpg_cluster_storage_class }}
