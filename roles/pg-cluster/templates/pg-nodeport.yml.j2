apiVersion: v1
kind: Service
metadata:
  name: {{ cnpg_cluster_name }}-nodeport
  namespace: {{ cnpg_cluster_namespace }}
spec:
  type: NodePort
  externalTrafficPolicy: Cluster
  selector:
    cnpg.io/cluster: {{ cnpg_cluster_name }}
    cnpg.io/instanceRole: primary
  ports:
    - name: postgres
      port: 5432
      targetPort: 5432
      nodePort: {{ pg_nodeport }}
